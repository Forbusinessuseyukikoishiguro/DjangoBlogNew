{
    "builds": [
      {
        "src": "myblog/wsgi.py",
        "use": "@vercel/python",
        "config": {
          "maxLambdaSize": "15mb",
          "runtime": "Python 3.10.12"
        }
      }
    ],
    "routes": [
      {
        "src": "/(.*)",
        "dest": "myblog/wsgi.py"
      }
    ]
  }